{
  "name": "personal-finance-guru",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck -w @pfg/web",
    "dev": "npm run dev -w @pfg/web",
    "build": "npm run build -w @pfg/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @pfg/db",
    "db:migrate": "npm run migrate -w @pfg/db",
    "db:studio": "npm run studio -w @pfg/db",
    "db:psql": "docker compose exec postgres psql -U pfg -d pfg_dev",
    "mcp": "npm run start -w @pfg/mcp",
    "link:sandbox": "tsx scripts/link-sandbox-item.ts",
    "set:profile": "tsx scripts/set-profile.ts",
    "checkpoint0": "tsx scripts/checkpoint0-summary.ts",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "transcribe:smoke": "tsx scripts/transcribe-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
