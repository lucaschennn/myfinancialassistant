# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
# Copy it to .env (which is gitignored) and fill that in instead.

# --- Database ---------------------------------------------------------------
# Local dev via docker compose (see docker-compose.yml). On deploy this is the
# Neon connection string, injected by the Vercel marketplace integration.
DATABASE_URL=postgres://pfg:pfg@localhost:5433/pfg_dev
# Neon's Vercel integration injects this alongside DATABASE_URL: same database,
# but bypassing the pgbouncer pooler. Migrations and Drizzle Studio use it when
# present (see packages/db/src/env.ts) because the migrator's session-level
# advisory lock does not survive transaction pooling. Leave it unset locally —
# Docker Postgres has no pooler, so DATABASE_URL is already direct.
# DATABASE_URL_UNPOOLED=

# --- Plaid (sandbox) --------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production. Keep this on `sandbox` until the §9 security checklist
# and the employer outside-activity check are both cleared.
PLAID_ENV=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Clerk (auth) -----------------------------------------------------------
# Create an application at clerk.com and copy these from API Keys → Next.js.
# The development instance's pk_test_/sk_test_ keys work on localhost AND on
# Vercel preview URLs, so a production instance is only needed once a custom
# domain is attached.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Not needed yet. User rows are provisioned just-in-time on the first
# authenticated request (see packages/core/src/tools/users.ts), which avoids
# needing a public tunnel in dev. Add a webhook after deploy if you want
# user.deleted to cascade.
# CLERK_WEBHOOK_SIGNING_SECRET=

# --- Encryption -------------------------------------------------------------
# AES-256-GCM key for Plaid access tokens at rest (§9). 32 bytes, base64.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- MCP dev harness --------------------------------------------------------
# The MCP server is a LOCAL dev/test harness only (never deployed). It runs as
# a single sandbox user; these two say which one.
# MCP_DEV_USER_ID must be the UUID printed by `npm run link:sandbox` — it is a
# users.id foreign key, not a username.
MCP_DEV_TOKEN=
MCP_DEV_USER_ID=
